// Windows resources for the GUI client: taskbar icon and the metadata shown in
// the Explorer "Details" tab, which the installer also reuses.
#include <windows.h>

#define VIBEZ_VERSION_MAJOR 0
#define VIBEZ_VERSION_MINOR 1
#define VIBEZ_VERSION_PATCH 0
#define VIBEZ_VERSION_BUILD 0
#define VIBEZ_VERSION_STRING "0.1.0.0"

IDI_VIBEZ ICON "../../installer/vibez.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VIBEZ_VERSION_MAJOR, VIBEZ_VERSION_MINOR, VIBEZ_VERSION_PATCH, VIBEZ_VERSION_BUILD
 PRODUCTVERSION VIBEZ_VERSION_MAJOR, VIBEZ_VERSION_MINOR, VIBEZ_VERSION_PATCH, VIBEZ_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VibeZ"
            VALUE "FileDescription", "VibeZ - voz e tela compartilhada"
            VALUE "FileVersion", VIBEZ_VERSION_STRING
            VALUE "InternalName", "VibeZ"
            VALUE "LegalCopyright", "VibeZ"
            VALUE "OriginalFilename", "VibeZ.exe"
            VALUE "ProductName", "VibeZ"
            VALUE "ProductVersion", VIBEZ_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
